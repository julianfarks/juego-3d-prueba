; Engine configuration file.
config_version=5

[application]

config/name="Lawyer Mayhem 3D"
config/description="Roguelike arcade 3D en tercera persona para Android."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://assets/icon/icon.png"

[autoload]

SaveSystem="*res://scripts/autoload/save_system.gd"
Config="*res://scripts/autoload/config.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"
GameState="*res://scripts/autoload/game_state.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[input_devices]

pointing/emulate_touch_from_mouse=true

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="enemy"
3d_physics/layer_4="pickup"
3d_physics/layer_5="camera_block"

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=4

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/vram_compression/import_s3tc_bptc=true
environment/defaults/default_clear_color=Color(0.05, 0.06, 0.1, 1)
